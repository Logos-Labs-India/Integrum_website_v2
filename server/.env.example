# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# S3 key prefix resumes are stored under, e.g. careers-resumes/2026/09/<file>
S3_RESUME_PREFIX=careers-resumes

# Verified SES sender identity. In SES sandbox mode this address (and HR_EMAIL,
# if different) must both be verified in the SES console before mail will send.
SES_FROM_EMAIL=manali@logos-labs.com
HR_EMAIL=manali@logos-labs.com

# Comma-separated list of origins allowed to call this API (your site's domain,
# plus http://localhost:5500 for local dev). Leave blank to allow any origin
# (fine for local testing, tighten before going live).
ALLOWED_ORIGINS=http://localhost:5500

PORT=4000
