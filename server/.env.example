# Copy this to .env and fill in real values. Never commit .env.

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Key prefix under which resumes are stored in the bucket.
S3_RESUME_PREFIX=careers-resumes

# Every successful form submission emails a summary via SES. All three
# addresses below must be verified SES identities in AWS_REGION (SES
# console -> Verified identities) — the server refuses to start without
# them set, and sends fail if they aren't actually verified in SES.
#
# SES_FROM_EMAIL is the sender.
SES_FROM_EMAIL=
# HR_EMAIL receives careers-application notifications. The recipient is
# always resolved server-side from the submission's own form/reason —
# never from client input, and never a hardcoded address in source — so
# this must be set for that routing to have anywhere to send to.
HR_EMAIL=
# GENERAL_NOTIFY_EMAIL receives every other form's notifications.
GENERAL_NOTIFY_EMAIL=

# Set to "production" when actually deployed — any http://localhost:*
# origin is allowed through CORS automatically unless this is set to
# exactly "production" (see ALLOWED_ORIGINS below).
NODE_ENV=development

# Comma-separated list of origins allowed to call this API. Required in
# production — ALLOWED_ORIGINS is checked regardless of NODE_ENV, but when
# NODE_ENV isn't "production", any http://localhost:* origin is also let
# through automatically, so this can stay empty for local dev.
ALLOWED_ORIGINS=

# Shared secret for GET /api/leads (the admin leads-viewer endpoint) — pass
# as the X-Admin-Key header. Leave blank to disable that endpoint entirely.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

PORT=4000

# postgresql://user:password@host:port/database
DATABASE_URL=

# Set to "true" to connect with ssl: { rejectUnauthorized: false } — needed
# for some managed/self-signed Postgres setups. Leave empty for a plain,
# non-TLS connection.
PGSSL_INSECURE=
