# Copy this to .env and fill in real values. Never commit .env.

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Key prefix under which resumes are stored in the bucket.
S3_RESUME_PREFIX=careers-resumes

# Every successful form submission emails a summary via SES.
# SES_FROM_EMAIL is the sender — it must be a verified SES identity in
# AWS_REGION (SES console -> Verified identities), or every send fails.
SES_FROM_EMAIL=

# Fallback recipient, used only when a submission's own `route_to` field is
# missing or not a valid email — each form normally sets its own route_to
# (e.g. a careers application routes to Careers@..., a general enquiry to
# info@...), so this is a safety net, not the usual recipient.
HR_EMAIL=

# Comma-separated list of origins allowed to call this API in production.
# (In development, any http://localhost:* origin is allowed automatically.)
ALLOWED_ORIGINS=

PORT=4000

# postgresql://user:password@host:port/database
DATABASE_URL=

# Set to "true" to connect with ssl: { rejectUnauthorized: false } — needed
# for some managed/self-signed Postgres setups. Leave empty for a plain,
# non-TLS connection.
PGSSL_INSECURE=
